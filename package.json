{
  "name": "mcp-pdf",
  "version": "1.0.1",
  "description": "A Model Context Protocol server for PDF manipulation and operations",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "pdf-mcp": "dist/server.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node build.js",
    "build:dev": "tsc",
    "build:types": "tsc --emitDeclarationOnly",
    "build:compare": "node build.js --compare",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "dev:watch": "nodemon --exec ts-node server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/pdf.integration.test.ts",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:cli": "jest tests/cli.test.ts",
    "init": "npm run build && node dist/server.js init",
    "status": "npm run build && node dist/server.js status",
    "clean": "rimraf dist coverage",
    "prepare": "husky",
    "prepublishOnly": "npm run clean && npm run build && npm run build:types",
    "release": "npm run build && node dist/release.js",
    "release:patch": "npm run build && node dist/release.js patch --yes",
    "release:minor": "npm run build && node dist/release.js minor --yes",
    "release:major": "npm run build && node dist/release.js major --yes",
    "release:dry": "npm run build && node dist/release.js --dry-run",
    "version:check": "echo \"Current version: $(node -p 'require(\"./package.json\").version')\"",
    "publish:check": "npm run prepublishOnly && npm pack --dry-run",
    "publish:public": "npm publish --access public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "npx",
    "pdf",
    "pdf-manipulation",
    "pdf-editing",
    "pdf-forms",
    "pdf-signatures",
    "pdf-merge",
    "pdf-split",
    "claude",
    "ai",
    "document-processing",
    "pdf-tools",
    "cli",
    "open-source",
    "typescript"
  ],
  "author": "Nitai Aharoni <nitaiaharoni1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitaiaharoni1/pdf-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nitaiaharoni1/pdf-mcp/issues"
  },
  "homepage": "https://github.com/nitaiaharoni1/pdf-mcp#readme",
  "files": [
    "dist/",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "node-forge": "^1.3.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.3",
    "@types/node-forge": "^1.3.11",
    "esbuild": "^0.25.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
